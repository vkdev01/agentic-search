# Copy to .env and fill in. Never commit .env.

# Chat models are configured in models.yaml; only their API keys go here.
# Leave a key empty to hide that provider. Ollama needs no key: running models appear automatically.
SARVAM_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# Overrides the Ollama URL in models.yaml (e.g. http://host.docker.internal:11434/v1 from Docker)
# OLLAMA_BASE_URL=

# Model used when the UI doesn't pick one, e.g. sarvam/sarvam-105b or ollama/qwen3:8b (default: models.yaml)
DEFAULT_MODEL=
# List the offline mock model (turn off when deployed)
MOCK_MODEL=true

# mock | searxng  (run `make searxng` for a local SearXNG on :8080)
SEARCH_PROVIDER=mock
SEARXNG_URL=http://localhost:8080

CORS_ORIGINS=["http://localhost:3000"]

# One row per LLM call (tokens, latency, finish reason, ...). Inspect with `make usage`.
LLM_USAGE_DB=data/llm_usage.db

# Fallbacks for models that don't set context_window / prices in models.yaml.
CONTEXT_WINDOW_TOKENS=128000
# Optional: price per 1M tokens to show session cost (check your provider's pricing page)
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=
PRICE_CURRENCY=INR
