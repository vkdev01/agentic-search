# Copy to .env and fill in. Never commit .env.

# mock | sarvam | ollama
LLM_PROVIDER=mock
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
SARVAM_MAX_TOKENS=16384
# low | medium | high | max
SARVAM_REASONING_EFFORT=low
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=

# mock | searxng  (run `make searxng` for a local SearXNG on :8080)
SEARCH_PROVIDER=mock
SEARXNG_URL=http://localhost:8080

CORS_ORIGINS=["http://localhost:3000"]

# One row per LLM call (tokens, latency, finish reason, ...). Inspect with `make usage`.
LLM_USAGE_DB=data/llm_usage.db

# Shown in the chat's session usage panel. sarvam-105b: 128000, sarvam-105b-conversations: 32000
CONTEXT_WINDOW_TOKENS=128000
# Optional: price per 1M tokens to show session cost (check your provider's pricing page)
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=
PRICE_CURRENCY=INR
